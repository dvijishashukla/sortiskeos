# .env.example — copy this to .env and fill in strong passwords
# .env is in .gitignore and must NEVER be committed to git

# Password for the built-in 'elastic' superuser
ELASTIC_PASSWORD=change_me_strong_password_1

# Password for the 'kibana_system' built-in user (used by Kibana)
KIBANA_PASSWORD=change_me_strong_password_2

# Password for 'logstash_writer' role (created by setup_es_security.sh)
LOGSTASH_PASSWORD=change_me_strong_password_3

# Password for 'ml_reader' role (used by ml_pipeline.py)
ML_PASSWORD=change_me_strong_password_4
